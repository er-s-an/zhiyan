# 本地服务端配置示例
# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略。

# 知乎开放平台 Access Secret（个人中心 -> 生成）
ZHIHU_ACCESS_SECRET=

# OpenAI 兼容 LLM（仅用于把中文摘录翻译成英文）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash

# OpenCode 本地 API（用于访谈中自然地问出下一题；不填则自动读取
# ~/.local/state/opencode/service.json，仅适合本机运行）
OPENCODE_BASE_URL=
OPENCODE_PASSWORD=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_PROVIDER=opencode-go
OPENCODE_VARIANT=low
# 访谈问法使用更快的模型；失败时自动回退到上面的主模型
OPENCODE_COACH_MODEL=minimax-m3.1-flash
OPENCODE_COACH_VARIANT=low
# 日语 / 俄语 / 韩语用更稳的多语模型
OPENCODE_COACH_MODEL_MULTILINGUAL=glm-5.3-flash
OPENCODE_COACH_VARIANT_MULTILINGUAL=low
OPENCODE_COACH_MODEL_RU_KO=glm-5.3-flash
OPENCODE_COACH_VARIANT_RU_KO=low
# 落地方案润色（可选；失败时保留规则版方案）
OPENCODE_PLAN_MODEL=minimax-m3.1-flash
OPENCODE_PLAN_VARIANT=low
OPENCODE_PLAN_MODEL_MULTILINGUAL=glm-5.3-flash
OPENCODE_PLAN_VARIANT_MULTILINGUAL=low
OPENCODE_PLAN_MODEL_RU_KO=glm-5.3-flash
OPENCODE_PLAN_VARIANT_RU_KO=low
# 研究搭子（右下角快速澄清 / 基于研究回答）
OPENCODE_DOCK_MODEL=minimax-m3.1-flash
OPENCODE_DOCK_VARIANT=low
OPENCODE_DOCK_MODEL_MULTILINGUAL=glm-5.3-flash
OPENCODE_DOCK_MODEL_RU_KO=glm-5.3-flash
